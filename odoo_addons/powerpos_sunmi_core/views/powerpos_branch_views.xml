<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerpos_branch_list" model="ir.ui.view">
        <field name="name">powerpos.branch.list</field>
        <field name="model">powerpos.branch</field>
        <field name="arch" type="xml">
            <list string="PowerPOS Branches">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="manager_id"/>
                <field name="device_count"/>
                <field name="alert_prolonged_open_seconds"/>
                <field name="alert_excessive_open_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_powerpos_branch_form" model="ir.ui.view">
        <field name="name">powerpos.branch.form</field>
        <field name="model">powerpos.branch</field>
        <field name="arch" type="xml">
            <form string="PowerPOS Store / Branch">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Makati Flagship Store"/></h1>
                        <h3><field name="code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Branch Identification">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="manager_id"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group string="Default Security Thresholds">
                            <field name="alert_prolonged_open_seconds"/>
                            <field name="alert_excessive_open_count"/>
                            <field name="device_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Registered SUNMI Devices" name="devices">
                            <field name="device_ids" readonly="1">
                                <list>
                                    <field name="device_code"/>
                                    <field name="name"/>
                                    <field name="serial_number"/>
                                    <field name="device_model"/>
                                    <field name="connection_type"/>
                                    <field name="capability_classification"/>
                                    <field name="device_status" widget="badge"
                                           decoration-success="device_status == 'online'"
                                           decoration-warning="device_status in ('degraded', 'unpaired')"
                                           decoration-danger="device_status in ('offline', 'error')"/>
                                </list>
                            </field>
                        </page>
                        <page string="POS Registers" name="pos_configs">
                            <field name="pos_config_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_powerpos_branch" model="ir.actions.act_window">
        <field name="name">Store Branches</field>
        <field name="res_model">powerpos.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
