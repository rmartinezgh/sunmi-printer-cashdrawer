<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_powerpos_hardware" model="ir.module.category">
            <field name="name">PowerPOS Hardware Management</field>
            <field name="description">Access rights for SUNMI Printers, Cash Drawers, and Security Monitoring</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_powerpos_cashier" model="res.groups">
            <field name="name">Cashier</field>
            <field name="category_id" ref="module_category_powerpos_hardware"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view assigned terminal hardware status and request standard authorized cash drawer openings.</field>
        </record>

        <record id="group_powerpos_supervisor" model="res.groups">
            <field name="name">Supervisor</field>
            <field name="category_id" ref="module_category_powerpos_hardware"/>
            <field name="implied_ids" eval="[(4, ref('group_powerpos_cashier'))]"/>
            <field name="comment">Can authorize No-Sale drawer openings, acknowledge security alerts, and review unmatched drawer events.</field>
        </record>

        <record id="group_powerpos_store_manager" model="res.groups">
            <field name="name">Store Manager</field>
            <field name="category_id" ref="module_category_powerpos_hardware"/>
            <field name="implied_ids" eval="[(4, ref('group_powerpos_supervisor')), (4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="comment">Can manage branch devices, policies, diagnostic runs, and branch analytics reports.</field>
        </record>

        <record id="group_powerpos_sysadmin" model="res.groups">
            <field name="name">System Administrator</field>
            <field name="category_id" ref="module_category_powerpos_hardware"/>
            <field name="implied_ids" eval="[(4, ref('group_powerpos_store_manager')), (4, ref('base.group_system'))]"/>
            <field name="comment">Full administrative access to SUNMI Cloud credentials, HMAC keys, hardware registration, and cryptographic audit verification.</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Multi-company isolation rules -->
        <record id="rule_powerpos_branch_multi_company" model="ir.rule">
            <field name="name">PowerPOS Branch: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_branch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_sunmi_device_multi_company" model="ir.rule">
            <field name="name">PowerPOS SUNMI Device: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_sunmi_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_device_capability_multi_company" model="ir.rule">
            <field name="name">PowerPOS Device Capability: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_device_capability"/>
            <field name="domain_force">[('device_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
