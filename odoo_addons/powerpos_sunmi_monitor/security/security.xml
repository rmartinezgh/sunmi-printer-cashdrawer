<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_powerpos_monitoring_rule_multi_company" model="ir.rule">
            <field name="name">PowerPOS Monitoring Rule: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_monitoring_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_security_alert_multi_company" model="ir.rule">
            <field name="name">PowerPOS Security Alert: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_security_alert"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_hardware_dashboard_multi_company" model="ir.rule">
            <field name="name">PowerPOS Hardware Dashboard: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_hardware_dashboard"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
