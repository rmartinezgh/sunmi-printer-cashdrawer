<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerpos_monitoring_rule_list" model="ir.ui.view">
        <field name="name">powerpos.monitoring.rule.list</field>
        <field name="model">powerpos.monitoring.rule</field>
        <field name="arch" type="xml">
            <list string="Security Monitoring Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="branch_id"/>
                <field name="pos_config_id"/>
                <field name="threshold_seconds"/>
                <field name="max_manual_openings_per_shift"/>
                <field name="severity" widget="badge"
                       decoration-info="severity == 'info'"
                       decoration-warning="severity == 'warning'"
                       decoration-danger="severity == 'critical'"/>
                <field name="notify_pos_screen"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_powerpos_monitoring_rule_form" model="ir.ui.view">
        <field name="name">powerpos.monitoring.rule.form</field>
        <field name="model">powerpos.monitoring.rule</field>
        <field name="arch" type="xml">
            <form string="Security Monitoring Rule">
                <sheet>
                    <group>
                        <group string="Rule Definition">
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="rule_type"/>
                            <field name="severity"/>
                            <field name="active"/>
                        </group>
                        <group string="Branch &amp; Register Scope">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="pos_config_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rule Threshold Parameters">
                            <field name="prolonged_open_preset" invisible="rule_type != 'prolonged_open'"/>
                            <field name="threshold_seconds" invisible="rule_type != 'prolonged_open'"/>
                            <field name="max_manual_openings_per_shift" invisible="rule_type != 'excessive_manual_open'"/>
                        </group>
                        <group string="Real-Time Notification Channels">
                            <field name="notify_pos_screen"/>
                            <field name="notify_supervisor_channel"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_powerpos_monitoring_rule" model="ir.actions.act_window">
        <field name="name">Monitoring Rules</field>
        <field name="res_model">powerpos.monitoring.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
