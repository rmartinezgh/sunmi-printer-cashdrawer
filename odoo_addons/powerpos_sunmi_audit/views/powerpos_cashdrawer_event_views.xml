<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerpos_cashdrawer_event_search" model="ir.ui.view">
        <field name="name">powerpos.cashdrawer.event.search</field>
        <field name="model">powerpos.cashdrawer.event</field>
        <field name="arch" type="xml">
            <search string="Search Drawer Activity Audit">
                <field name="event_uuid"/>
                <field name="cash_drawer_id"/>
                <field name="branch_id"/>
                <field name="pos_config_id"/>
                <field name="cashier_id"/>
                <field name="event_type"/>
                <filter string="Unmatched Openings" name="filter_unmatched" domain="[('event_type', '=', 'unmatched_opening')]"/>
                <filter string="Prolonged Open Timeouts" name="filter_timeout" domain="[('event_type', '=', 'drawer_open_timeout')]"/>
                <filter string="Supervisor Overrides" name="filter_supervisor" domain="[('event_type', '=', 'supervisor_override_open')]"/>
                <filter string="Pending Supervisor Review" name="filter_pending_review" domain="[('review_status', '=', 'pending_review')]"/>
                <separator/>
                <filter string="Group by Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                <filter string="Group by Cash Drawer" name="group_drawer" context="{'group_by': 'cash_drawer_id'}"/>
                <filter string="Group by Event Type" name="group_event_type" context="{'group_by': 'event_type'}"/>
                <filter string="Group by Cashier" name="group_cashier" context="{'group_by': 'cashier_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_powerpos_cashdrawer_event_list" model="ir.ui.view">
        <field name="name">powerpos.cashdrawer.event.list</field>
        <field name="model">powerpos.cashdrawer.event</field>
        <field name="arch" type="xml">
            <list string="Immutable Cash Drawer Activity Ledger" create="0" delete="0">
                <field name="device_observed_timestamp"/>
                <field name="branch_id"/>
                <field name="pos_config_id"/>
                <field name="cash_drawer_id"/>
                <field name="event_type" widget="badge"
                       decoration-danger="event_type in ('unmatched_opening', 'drawer_open_timeout', 'sensor_error', 'drawer_open_failed')"
                       decoration-warning="event_type in ('supervisor_override_open', 'device_offline')"
                       decoration-success="event_type in ('sale_auto_open', 'drawer_closed')"
                       decoration-info="event_type in ('drawer_opened', 'manual_open_authorized')"/>
                <field name="previous_physical_state"/>
                <field name="new_physical_state"/>
                <field name="opening_reason"/>
                <field name="cashier_id"/>
                <field name="pos_order_id"/>
                <field name="opening_duration"/>
                <field name="is_duration_incomplete"/>
                <field name="review_status" widget="badge"
                       decoration-warning="review_status in ('pending_review', 'under_investigation')"
                       decoration-success="review_status == 'resolved_justified'"
                       decoration-danger="review_status == 'resolved_exception'"/>
                <field name="event_hash"/>
            </list>
        </field>
    </record>

    <record id="view_powerpos_cashdrawer_event_form" model="ir.ui.view">
        <field name="name">powerpos.cashdrawer.event.form</field>
        <field name="model">powerpos.cashdrawer.event</field>
        <field name="arch" type="xml">
            <form string="Cash Drawer Audit Event" create="0" delete="0">
                <header>
                    <field name="review_status" widget="statusbar"
                           statusbar_visible="not_required,pending_review,under_investigation,resolved_justified,resolved_exception"/>
                </header>
                <sheet>
                    <group>
                        <group string="Immutable Event Identity &amp; Hardware Context">
                            <field name="event_uuid"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="pos_config_id"/>
                            <field name="cash_drawer_id"/>
                            <field name="printer_id"/>
                            <field name="event_source"/>
                            <field name="sequence_number"/>
                            <field name="sensor_quality"/>
                            <field name="hardware_firmware"/>
                        </group>
                        <group string="State Transition &amp; Timing">
                            <field name="event_type"/>
                            <field name="previous_physical_state"/>
                            <field name="new_physical_state"/>
                            <field name="opening_reason"/>
                            <field name="opening_request_timestamp"/>
                            <field name="device_observed_timestamp"/>
                            <field name="server_received_timestamp"/>
                            <field name="clock_drift_seconds"/>
                            <field name="opening_duration"/>
                            <field name="is_duration_incomplete"/>
                        </group>
                    </group>
                    <group>
                        <group string="Operator &amp; Transaction Correlation">
                            <field name="cashier_id"/>
                            <field name="user_id"/>
                            <field name="pos_session_id"/>
                            <field name="pos_order_id"/>
                            <field name="authorization_id"/>
                            <field name="authorization_ref"/>
                        </group>
                        <group string="Supervisor Exception Review (Editable by Supervisor)">
                            <field name="review_status"/>
                            <field name="supervisor_id"/>
                            <field name="review_notes"/>
                        </group>
                    </group>
                    <group string="SHA-256 Cryptographic Hash Chain">
                        <field name="previous_event_hash"/>
                        <field name="event_hash"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_powerpos_cashdrawer_event" model="ir.actions.act_window">
        <field name="name">Drawer Activity Audit</field>
        <field name="res_model">powerpos.cashdrawer.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
