<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerpos_cashdrawer_policy_list" model="ir.ui.view">
        <field name="name">powerpos.cashdrawer.policy.list</field>
        <field name="model">powerpos.cashdrawer.policy</field>
        <field name="arch" type="xml">
            <list string="Cash Drawer Security Policies">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="pos_config_id"/>
                <field name="auto_open_cash_sale"/>
                <field name="refund_open_policy"/>
                <field name="no_sale_requires_supervisor"/>
                <field name="correlation_window_seconds"/>
                <field name="cooldown_lock_seconds"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_powerpos_cashdrawer_policy_form" model="ir.ui.view">
        <field name="name">powerpos.cashdrawer.policy.form</field>
        <field name="model">powerpos.cashdrawer.policy</field>
        <field name="arch" type="xml">
            <form string="Cash Drawer Authorization Policy">
                <sheet>
                    <group>
                        <group string="Policy Scope">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="pos_config_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Opening Rules &amp; Controls">
                            <field name="auto_open_cash_sale"/>
                            <field name="refund_open_policy"/>
                            <field name="manual_open_requires_reason"/>
                            <field name="no_sale_requires_supervisor"/>
                            <field name="allow_remote_open"/>
                            <field name="offline_open_policy"/>
                        </group>
                    </group>
                    <group string="Correlation &amp; Cooldown Timing">
                        <field name="correlation_window_seconds"/>
                        <field name="cooldown_lock_seconds"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_powerpos_cashdrawer_policy" model="ir.actions.act_window">
        <field name="name">Cash Drawer Policies</field>
        <field name="res_model">powerpos.cashdrawer.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
