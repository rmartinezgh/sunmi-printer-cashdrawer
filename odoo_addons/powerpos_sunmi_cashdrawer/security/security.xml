<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_powerpos_cashdrawer_device_multi_company" model="ir.rule">
            <field name="name">PowerPOS Cash Drawer Device: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_cashdrawer_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_cashdrawer_policy_multi_company" model="ir.rule">
            <field name="name">PowerPOS Cash Drawer Policy: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_cashdrawer_policy"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_cashdrawer_authorization_multi_company" model="ir.rule">
            <field name="name">PowerPOS Cash Drawer Authorization: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_cashdrawer_authorization"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
