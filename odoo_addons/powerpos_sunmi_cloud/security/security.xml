<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_powerpos_sunmi_cloud_account_multi_company" model="ir.rule">
            <field name="name">PowerPOS SUNMI Cloud Account: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_sunmi_cloud_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_sunmi_print_job_multi_company" model="ir.rule">
            <field name="name">PowerPOS SUNMI Print Job: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_sunmi_print_job"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_powerpos_sunmi_receipt_template_multi_company" model="ir.rule">
            <field name="name">PowerPOS SUNMI Receipt Template: Multi-Company Rule</field>
            <field name="model_id" ref="model_powerpos_sunmi_receipt_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
