<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_powerpos_sunmi_cloud_account_list" model="ir.ui.view">
        <field name="name">powerpos.sunmi.cloud.account.list</field>
        <field name="model">powerpos.sunmi.cloud.account</field>
        <field name="arch" type="xml">
            <list string="SUNMI Cloud Accounts">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="app_id"/>
                <field name="base_url"/>
                <field name="timeout_seconds"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_powerpos_sunmi_cloud_account_form" model="ir.ui.view">
        <field name="name">powerpos.sunmi.cloud.account.form</field>
        <field name="model">powerpos.sunmi.cloud.account</field>
        <field name="arch" type="xml">
            <form string="SUNMI Cloud Account">
                <sheet>
                    <group>
                        <group string="SUNMI OpenAPI Credentials">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="app_id"/>
                            <field name="app_key" password="True" groups="powerpos_sunmi_core.group_powerpos_sysadmin"/>
                            <field name="webhook_secret" password="True" groups="powerpos_sunmi_core.group_powerpos_sysadmin"/>
                        </group>
                        <group string="Endpoint Settings">
                            <field name="base_url"/>
                            <field name="timeout_seconds"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_powerpos_sunmi_cloud_account" model="ir.actions.act_window">
        <field name="name">SUNMI Cloud Accounts</field>
        <field name="res_model">powerpos.sunmi.cloud.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
